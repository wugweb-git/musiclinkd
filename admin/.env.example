# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real Firebase credentials here.
#
# Get these from: Firebase console → Project settings → your web app config,
# or `firebase apps:sdkconfig WEB <appId>` once you've run `firebase login`.
# If no web app exists yet for musiclinkd-7ae30, create one first:
#   firebase apps:create WEB "MusicLinkd Admin" --project musiclinkd-7ae30
#
# These values are not secrets — they identify the Firebase project, not
# authorize access (Firestore/Storage rules + App Check do that). Still kept
# out of git for consistency with the rest of this repo's config handling.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=musiclinkd-7ae30.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=musiclinkd-7ae30
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=musiclinkd-7ae30.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=846160129456
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — App Check stays inert until this is set (see services/app-check.ts).
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

NEXT_PUBLIC_SUPPORT_EMAIL=hello@musiclinkd.com
NEXT_PUBLIC_WEBSITE_URL=https://musiclinkd.com
NEXT_PUBLIC_ADMIN_URL=https://admin.musiclinkd.com
NEXT_PUBLIC_APP_URL=https://app.musiclinkd.com
