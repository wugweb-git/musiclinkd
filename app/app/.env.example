# MusicLinkd Android — environment template.
# Copy to `.env` (this exact filename — see the Secrets Gradle Plugin config
# in app/build.gradle.kts: propertiesFileName = ".env") and fill in real
# values. `.env` is gitignored; never commit it.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Authoritative Firebase backend — single project for now, see
# app/docs/environment/Build_And_Environment_Guide.md.
FIREBASE_PROJECT_ID=musiclinkd-7ae30

# App Links / deep link host — varies by build target, see the per-target
# reference values in app/docs/variables/environment_variables.md.
DEEP_LINK_HOST=app.musiclinkd.com

ENVIRONMENT=production
ENABLE_ANALYTICS=true
LOG_LEVEL=WARN
