{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MusicLinkd Design Tokens",
    "version": "2026.1",
    "sourceOfTruth": "guide/",
    "interactiveReference": "guide/index.html"
  },
  "color": {
    "brand": {
      "primary": { "$value": "#EA4C89", "$type": "color" },
      "dark": { "$value": "#0D0B26", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "#FFFFFF", "$type": "color" },
      "background": { "$value": "#FCFCFD", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#0D0B26", "$type": "color" },
      "secondary": { "$value": "#7D7D8E", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#ECECF1", "$type": "color" },
      "focus": { "$value": "#EA4C89", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#22C55E", "$type": "color" },
      "warning": { "$value": "#F59E0B", "$type": "color" },
      "error": { "$value": "#DC2626", "$type": "color" }
    }
  },
  "space": {
    "xs": { "$value": "4px", "$type": "dimension" },
    "sm": { "$value": "8px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "2xl": { "$value": "48px", "$type": "dimension" },
    "3xl": { "$value": "64px", "$type": "dimension" },
    "4xl": { "$value": "96px", "$type": "dimension" },
    "5xl": { "$value": "128px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "12px", "$type": "dimension" },
    "md": { "$value": "16px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "xl": { "$value": "32px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "display": { "$value": "Inter Tight", "$type": "fontFamily" },
      "body": { "$value": "Inter", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" }
    },
    "scale": {
      "display": { "$value": "28px - 52px / 800", "$type": "typography" },
      "heading": { "$value": "20px - 28px / 700", "$type": "typography" },
      "bodyLarge": { "$value": "16px - 17px / 500", "$type": "typography" },
      "body": { "$value": "14px / 400", "$type": "typography" },
      "caption": { "$value": "11px - 12px / 400", "$type": "typography" }
    }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "description": "Button presses, chip toggles" },
      "medium": { "$value": "200ms", "$type": "duration", "description": "Hover states, icon changes" },
      "slow": { "$value": "300ms", "$type": "duration", "description": "Card lifts, page transitions, sheet reveal" },
      "entrance": { "$value": "500ms", "$type": "duration", "description": "Modal fade+scale, splash fade-in" }
    },
    "easing": {
      "default": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" }
    }
  },
  "stroke": {
    "subtle": { "$value": "1px solid #ECECF1", "$type": "border", "description": "Standard dividers, card borders" },
    "focus": { "$value": "2px solid #EA4C89", "$type": "border", "description": "Active input focus outline" }
  }
}