{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MusicLinkd Enterprise Design Tokens",
    "version": "5.5.0",
    "sourceOfTruth": "guide/tokens/tokens.json",
    "interactiveReference": "guide/styleguide.html"
  },
  "foundation": {
    "color": {
      "pink": {
        "$value": "#EA4C89",
        "$type": "color"
      },
      "navy": {
        "$value": "#0D0B26",
        "$type": "color"
      },
      "paper": {
        "$value": "#FCFCFD",
        "$type": "color"
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "line": {
        "$value": "#ECECF1",
        "$type": "color"
      },
      "muted": {
        "$value": "#7D7D8E",
        "$type": "color"
      },
      "green": {
        "$value": "#22C55E",
        "$type": "color"
      },
      "amber": {
        "$value": "#F59E0B",
        "$type": "color"
      },
      "red": {
        "$value": "#DC2626",
        "$type": "color"
      }
    },
    "spacing": {
      "0": {
        "$value": "0dp",
        "$type": "dimension"
      },
      "xs": {
        "$value": "4dp",
        "$type": "dimension"
      },
      "sm": {
        "$value": "8dp",
        "$type": "dimension"
      },
      "md": {
        "$value": "16dp",
        "$type": "dimension"
      },
      "lg": {
        "$value": "24dp",
        "$type": "dimension"
      },
      "xl": {
        "$value": "32dp",
        "$type": "dimension"
      },
      "2xl": {
        "$value": "48dp",
        "$type": "dimension"
      }
    },
    "radius": {
      "sm": {
        "$value": "12dp",
        "$type": "dimension"
      },
      "media": {
        "$value": "16dp",
        "$type": "dimension"
      },
      "card": {
        "$value": "24dp",
        "$type": "dimension"
      },
      "pill": {
        "$value": "9999dp",
        "$type": "dimension"
      },
      "avatar": {
        "$value": "50%",
        "$type": "dimension"
      }
    },
    "touch": {
      "targetMin": {
        "$value": "48dp",
        "$type": "dimension"
      },
      "comfortable": {
        "$value": "56dp",
        "$type": "dimension"
      }
    },
    "safeArea": {
      "top": {
        "$value": "24dp",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "16dp",
        "$type": "dimension"
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": {
        "$value": "{foundation.color.paper}",
        "$type": "color"
      },
      "card": {
        "$value": "{foundation.color.white}",
        "$type": "color"
      },
      "navyHero": {
        "$value": "{foundation.color.navy}",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "{foundation.color.navy}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{foundation.color.muted}",
        "$type": "color"
      },
      "brand": {
        "$value": "{foundation.color.pink}",
        "$type": "color"
      }
    },
    "audio": {
      "playerHeight": {
        "$value": "72dp",
        "$type": "dimension"
      },
      "waveformActive": {
        "$value": "{foundation.color.pink}",
        "$type": "color"
      },
      "waveformBuffer": {
        "$value": "{foundation.color.line}",
        "$type": "color"
      }
    },
    "haptic": {
      "selection": {
        "$value": "AndroidHapticFeedback.SELECTION",
        "$type": "haptic"
      },
      "success": {
        "$value": "AndroidHapticFeedback.CONFIRM",
        "$type": "haptic"
      },
      "waveform": {
        "$value": "AndroidHapticFeedback.VIRTUAL_KEY",
        "$type": "haptic"
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": {
          "$value": "{semantic.text.brand}",
          "$type": "color"
        },
        "text": {
          "$value": "{foundation.color.white}",
          "$type": "color"
        },
        "minHeight": {
          "$value": "{foundation.touch.targetMin}",
          "$type": "dimension"
        }
      }
    },
    "waveformPlayer": {
      "activeBar": {
        "$value": "{semantic.audio.waveformActive}",
        "$type": "color"
      },
      "barWidth": {
        "$value": "3dp",
        "$type": "dimension"
      }
    }
  },
  "screen": {
    "discover": {
      "heroBackground": {
        "$value": "{semantic.surface.navyHero}",
        "$type": "color"
      }
    },
    "profile": {
      "headerHeight": {
        "$value": "120dp",
        "$type": "dimension"
      }
    }
  }
}