{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "MusicLinkd",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1320px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Brand Pink",
					"color": "#FF005C"
				},
				{
					"slug": "primary-hover",
					"name": "Brand Pink Hover",
					"color": "#D9004E"
				},
				{
					"slug": "secondary",
					"name": "Navy Black",
					"color": "#141414"
				},
				{
					"slug": "background",
					"name": "Background",
					"color": "#FCFCFD"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface-card",
					"name": "Surface Card",
					"color": "#FFFFFF"
				},
				{
					"slug": "foreground",
					"name": "Text Main",
					"color": "#141414"
				},
				{
					"slug": "foreground-muted",
					"name": "Text Muted",
					"color": "#7D7D8E"
				},
				{
					"slug": "border",
					"name": "Border Subtle",
					"color": "#ECECF1"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Inter",
					"slug": "inter"
				},
				{
					"fontFamily": "'Inter Tight', -apple-system, BlinkMacSystemFont, sans-serif",
					"name": "Inter Tight",
					"slug": "inter-tight"
				},
				{
					"fontFamily": "'Unica One', cursive, sans-serif",
					"name": "Unica One",
					"slug": "unica-one"
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"name": "System Sans",
					"slug": "system"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"name": "Large",
					"size": "1.25rem",
					"slug": "large"
				},
				{
					"name": "Extra Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"name": "2X Large",
					"size": "2.5rem",
					"slug": "2x-large"
				},
				{
					"name": "3X Large",
					"size": "3.5rem",
					"slug": "3x-large"
				}
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vh", "vw"],
			"spacingScale": {
				"operator": "*",
				"increment": 1.5,
				"steps": 7,
				"mediumStep": 1.5,
				"unit": "rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|foreground"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|primary-hover"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|foreground"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|3x-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|2x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "#FFFFFF"
				},
				"border": {
					"radius": "9999px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-hover"
					}
				}
			}
		}
	}
}
