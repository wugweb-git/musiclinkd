rules_version = '2';

// Canonical source: app/docs/firestore/Firestore_Schema_Index_Rules.md
// Keep that doc and this file in sync by hand when the schema changes.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return adminRole() == 'ROLE_ADMIN';
    }

    function isModerator() {
      return isAdmin() || adminRole() == 'ROLE_MODERATOR';
    }

    function isSupport() {
      return isAdmin() || adminRole() == 'ROLE_SUPPORT';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if true;
      // primaryRole/secondaryRole values come from the "person_types"
      // master-data category (admin-managed, dynamic) — not a fixed enum
      // here anymore, so this only checks the field is present/typed.
      allow create: if isModerator()
        || (isOwner(userId)
            && request.resource.data.primaryRole is string
            && request.resource.data.isVerified == false
            && request.resource.data.isBanned == false);
      allow update: if isModerator()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['isVerified', 'isBanned', 'primaryRole', 'secondaryRole', 'supportingRoles', 'trustBadges', 'profileType']));
    }

    match /admin_roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /connections/{connectionId} {
      allow read, write: if signedIn()
        && (request.auth.uid == resource.data.senderUid
            || request.auth.uid == resource.data.targetUserId);
    }

    // One-directional block — distinct from moderation_flags (a one-time
    // report). Doc ID convention: "{blockerUid}_{blockedUid}", matching
    // user_bookmarks below. Only the blocker (and moderators) can read/
    // delete their own block docs; the blocked user has no read access to
    // who has blocked them. Proposed 2026-08-16 per
    // docs/04-Wireframes/PERSON-PROFILE-SPEC.md §4 — no confirmed app-side
    // writer yet.
    match /blocks/{blockId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.blockerUid;
      allow read, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.blockerUid);
    }

    match /feed_posts/{postId} {
      allow read: if true;
      allow create, update: if signedIn()
        && (request.auth.uid == request.resource.data.authorUid || isModerator());
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.authorUid);
    }

    match /studio_bookings/{bookingId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read: if signedIn()
        && (request.auth.uid == resource.data.userId
            || request.auth.uid == get(/databases/$(database)/documents/studios/$(resource.data.studioId)).data.ownerUid
            || isModerator());
      // The booker may only ever cancel their own booking — every other
      // status/payment transition belongs to the studio owner or a
      // moderator, closing the window a buggy/malicious client would
      // otherwise have to mark their own booking "completed" or "paid".
      allow update: if isModerator()
        || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/studios/$(resource.data.studioId)).data.ownerUid)
        || (signedIn() && request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus'])
            && request.resource.data.bookingStatus == 'cancelled');
    }

    match /chat_threads/{threadId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;

      match /messages/{messageId} {
        allow read, create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_threads/$(threadId)).data.memberUids;
      }
    }

    match /studios/{studioId} {
      allow read: if true;
      // isModerator() can create on behalf of a partner studio's owner
      // (e.g. onboarding a business partner from the admin panel) — matches
      // the same isModerator()-OR-owner shape already used by /users create.
      allow create: if isModerator()
        || (signedIn() && request.auth.uid == request.resource.data.ownerUid);
      allow update, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == request.resource.data.creatorUid;
      allow update, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.creatorUid);
    }

    // Also the backing collection for Flow 5 (Opportunities) applications —
    // /projects/{projectId} above is the opportunity itself, this is one
    // person's application to it. Applicant creates; applicant or the
    // opportunity's poster (fetched via get()) can read; only the poster
    // (or a moderator) can update status — same shape as D.3's spec note.
    // Proposed 2026-08-16 per docs/04-Wireframes/PRODUCT-SPEC.md §D.2/§D.3
    // — Phase 2, not built yet (MVP uses "Message the poster" instead).
    match /opportunity_applications/{applicationId} {
      allow read: if isModerator()
        || (signedIn() && (request.auth.uid == resource.data.applicantUid
            || request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.opportunityId)).data.creatorUid));
      allow create: if signedIn() && request.auth.uid == request.resource.data.applicantUid;
      allow update: if isModerator()
        || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/projects/$(resource.data.opportunityId)).data.creatorUid);
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.applicantUid);
    }

    match /marketplace_items/{itemId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == request.resource.data.sellerUid;
      allow update, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.sellerUid);
    }

    // The shared Make Offer / Negotiate / Accept primitive for Marketplace
    // (both sale and rental listings — rent stayed merged into Marketplace,
    // not a separate flow). Buyer initiates; either party negotiates via
    // update (counter/accept/decline). Proposed 2026-08-16 per
    // docs/04-Wireframes/PRODUCT-SPEC.md §B.3 — Phase 2, not built yet.
    match /offers/{offerId} {
      allow read: if isModerator()
        || (signedIn() && (request.auth.uid == resource.data.buyerUid
            || request.auth.uid == resource.data.sellerUid));
      allow create: if signedIn() && request.auth.uid == request.resource.data.buyerUid;
      allow update: if isModerator()
        || (signedIn() && (request.auth.uid == resource.data.buyerUid
            || request.auth.uid == resource.data.sellerUid));
    }

    // One order/transaction record for both a Buy purchase and a Rent
    // booking (rent didn't get its own booking collection). Either party
    // may create it (e.g. the seller creating it once an offer is
    // accepted). Proposed 2026-08-16 per
    // docs/04-Wireframes/PRODUCT-SPEC.md §B.3 — Phase 2, not built yet.
    match /marketplace_orders/{orderId} {
      allow read: if isModerator()
        || (signedIn() && (request.auth.uid == resource.data.buyerUid
            || request.auth.uid == resource.data.sellerUid));
      allow create: if signedIn() && (request.auth.uid == request.resource.data.buyerUid
          || request.auth.uid == request.resource.data.sellerUid);
      allow update: if isModerator()
        || (signedIn() && (request.auth.uid == resource.data.buyerUid
            || request.auth.uid == resource.data.sellerUid));
    }

    match /reviews/{reviewId} {
      allow read: if true;
      // An optional bookingId links this review to a "verified purchase" —
      // if present, it must actually belong to the reviewer, checked
      // server-side rather than trusting an unverified client flag. Same
      // idea for the new optional orderId (added 2026-08-16 alongside the
      // MARKETPLACE_ITEM targetType, PRODUCT-SPEC.md §B.3, Phase 2) —
      // verifies against marketplace_orders instead of studio_bookings.
      allow create, update: if signedIn()
        && request.auth.uid == request.resource.data.authorUid
        && reviewId == request.auth.uid + '_' + request.resource.data.targetId
        && (!('bookingId' in request.resource.data)
            || request.resource.data.bookingId == ''
            || get(/databases/$(database)/documents/studio_bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid)
        && (!('orderId' in request.resource.data)
            || request.resource.data.orderId == ''
            || get(/databases/$(database)/documents/marketplace_orders/$(request.resource.data.orderId)).data.buyerUid == request.auth.uid);
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.authorUid);
    }

    match /verification_requests/{requestId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.submittedBy;
      allow read: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.submittedBy);
      allow update: if isModerator();
    }

    match /moderation_flags/{flagId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.reportedBy;
      allow read: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.reportedBy);
      allow update: if isModerator();
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.requesterUid;
      allow read, update: if isSupport()
        || (signedIn() && request.auth.uid == resource.data.requesterUid);
    }

    match /broadcast_messages/{broadcastId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isModerator();
    }

    match /page_content/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /taxonomy_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();

      match /options/{optionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /modules/{moduleKey} {
      allow read: if true;
      // v1: isAdmin() may write `enabled` directly from the client — no
      // Cloud Function required (Firebase Functions need the Blaze plan;
      // this project stays on Spark). The Remote Config mirror described in
      // backend/functions/src/index.ts (toggleModule) is a documented,
      // deferred follow-up — not called by the admin UI right now. See
      // admin/docs/architecture/Edge_Functions_And_Errors.md.
      allow create: if isAdmin() && request.resource.data.enabled == false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Corrects AI Studio's original /musicians/{userId}/portfolio_projects
    // design — top-level collection + ownerUid field, matching the
    // studios/projects/marketplace_items convention, not a subcollection
    // under /users/{uid} (no precedent for that nesting anywhere in this
    // schema). No admin UI yet — see admin/docs/architecture/ for the
    // deferred Portfolio admin-module follow-up.
    match /portfolio_projects/{projectId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
    }

    // Same correction as portfolio_projects — top-level, not
    // /musicians/{userId}/social_links. Doc ID convention:
    // "{ownerUid}_{platformKey}".
    match /social_links/{linkId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
    }

    // Corresponds to the app's SavedProfilesScreen. Add/remove only, no
    // update — a bookmark either exists or doesn't. Doc ID convention:
    // "{ownerUid}_{savedUserId}".
    match /user_bookmarks/{bookmarkId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow read, delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // No Cloud Functions exist to write these server-side (Spark plan, no
    // functions deployed) — a notification is created directly by the
    // client of the user who triggered it (e.g. the sender of a connection
    // request writes a notification doc targeting the recipient). Only the
    // target user may mark it read; only they or a moderator may delete it.
    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.userId);
      allow update: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']));
    }

    // Doc ID = the user's own UID — private preferences, owner-only.
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Doc ID = the profile owner's UID, same convention as user_settings.
    // Private to the owner (and admins) — analytics aren't public data.
    // Counter fields are incremented by the *viewing* client (no Cloud
    // Functions on this project's Spark plan — same constraint documented
    // on /notifications above), so any signed-in user may update, but only
    // the listed counter fields; only the owner/admin may write anything
    // else (e.g. correcting a value). Proposed 2026-08-16 per
    // docs/04-Wireframes/PERSON-PROFILE-SPEC.md §4.
    match /profile_analytics/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin()
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['profileViews', 'portfolioViews', 'audioPlays', 'videoPlays',
                        'searchAppearances', 'shareCount', 'connectionRequestsReceived',
                        'updatedAt']));
    }

    // Public-read (logos/brand imagery render on public profile pages),
    // owner-uid pattern matching portfolio_projects/social_links.
    match /brand_assets/{assetId} {
      allow read: if true;
      // isModerator() bypass added 2026-08-13 so the admin panel's Brand
      // Assets module can edit any business's assets, matching the same
      // pattern already used on /users/{userId} — without it, an admin's
      // auth.uid never equals the target business's ownerUid and every
      // admin-side save would be rejected.
      allow create, update: if isModerator()
        || (signedIn() && request.auth.uid == request.resource.data.ownerUid);
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
    }

    // One document per role a user plays (Singer, Musician, Sound Engineer,
    // etc.) — doc ID "${ownerUid}_${roleKey}". Same owner-uid pattern as
    // portfolio_projects/social_links; a person can hold several of these
    // simultaneously (e.g. Singer AND Sound Engineer), each independent.
    match /role_profiles/{profileId} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if isModerator()
        || (signedIn() && request.auth.uid == resource.data.ownerUid);
    }

    // Internal product/engineering documentation (flow -> screens -> schema
    // mapping) — not user-facing data, so read is moderator-only rather than
    // public, matching page_content/taxonomy_categories' admin-write but
    // narrowing read since this has no public-site consumer.
    match /flows/{flowId} {
      allow read: if isModerator();
      allow write: if isAdmin();

      match /screens/{screenId} {
        allow read: if isModerator();
        allow write: if isAdmin();
      }
    }

    // What a role/profile type is permitted to do — public read so the app
    // can gate UI client-side, admin-only write. Same shape as /modules.
    match /capabilities/{roleKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The app's UI-component catalog as data — internal engineering
    // documentation, same access shape as /flows (moderator-read, admin-write).
    match /widgets/{widgetId} {
      allow read: if isModerator();
      allow write: if isAdmin();
    }
  }
}
