.DS_Store
node_modules/
.firebase/
firebase-debug.log
firebase-debug.*.log
*.local

# Real secrets — never commit. Only .env.example (placeholders) is tracked.
.env
.env.local
!.env.example

# Generated by scripts/build-hosting.sh — merge of website/ + admin/out/,
# not a source directory.
/dist/

# Competitor/design-inspiration reference screenshots (~305MB) — not used by
# the live site (confirmed: not marketing photography, not referenced by any
# page). Keeping this out of git history on purpose; remove this rule if you
# actually want it versioned.
# NOTE 2026-08-29: the four rules here used to read behance/ spotify/ shazam/
# tinder/ — folder names that do not exist on disk. scripts/build-hosting.sh
# renames them on the way into dist/, so the source folders are numbered.
# The rules therefore matched nothing and 279MB across 441 files sat untracked
# AND unignored, one `git add -A` away from entering history.
/frontend/website/assets/img/1/*
/frontend/website/assets/img/4/*
/frontend/website/assets/img/5/*
/frontend/website/assets/img/6/*
/frontend/website/assets/img/inspiration/*

# ...EXCEPT the ones the shipping markup actually references. These are product
# imagery, not reference material, and leaving them untracked meant the live
# site's photographs existed on exactly one laptop: 47 screens rendered
# correctly on the machine that deployed them and showed broken images on every
# other clone, and no CI runner could ever build this repo. Same defect the
# editorials/ and speakers/ note above describes fixing — it just was not
# finished for the numbered folders.
#
# 57 files, 25.8MB. Derived from the same grep build-hosting.sh uses to build
# its ship-list, so this list and the deploy agree by construction. Regenerate:
#
#   grep -ohE 'assets/img/(1|4|5|6|inspiration)/[^"')? ]+\.(jpg|jpeg|png|webp|gif|mp4|webm)' \
#     frontend/guide/index.html frontend/guide/styleguide.html frontend/website/*.html \
#     webapp/index.html webapp/flows/*/*/index.html | sort -u
#
# Reference the image from a new screen and you must add it here too, or that
# screen ships broken to everyone but you.
!/frontend/website/assets/img/4/1312x830_ES_ICP_Brand_License.webp
!/frontend/website/assets/img/4/3-EAR-Alpha-hevc-safari.mp4
!/frontend/website/assets/img/4/3_featured_image.jpg
