.DS_Store
node_modules/
.firebase/
firebase-debug.log
firebase-debug.*.log
*.local

# Real secrets — never commit. Only .env.example (placeholders) is tracked.
.env
.env.local
!.env.example

# Generated by scripts/build-hosting.sh — merge of website/ + admin/out/,
# not a source directory.
/dist/

# Competitor/design-inspiration reference screenshots (~305MB) — not used by
# the live site (confirmed: not marketing photography, not referenced by any
# page). Keeping this out of git history on purpose; remove this rule if you
# actually want it versioned.
# NOTE 2026-08-29: the four rules here used to read behance/ spotify/ shazam/
# tinder/ — folder names that do not exist on disk. scripts/build-hosting.sh
# renames them on the way into dist/, so the source folders are numbered.
# The rules therefore matched nothing and 279MB across 441 files sat untracked
# AND unignored, one `git add -A` away from entering history.
/frontend/website/assets/img/1/
/frontend/website/assets/img/4/
/frontend/website/assets/img/5/
/frontend/website/assets/img/6/
/frontend/website/assets/img/inspiration/
# A ~300MB local archive of the image folder above, referenced by no page and
# not a web asset. It was untracked AND unignored, so `git add -A` would have
# put 300MB into history permanently.
/frontend/website/assets/img.zip
# editorials/ and speakers/ are NO LONGER ignored: Flow 4's screens reference
# them by path, so leaving them untracked meant Discover rendered correctly on
# the machine that deployed it and showed broken images on every other clone.
# The remaining folders above stay ignored — they are Behance CDN captures,
# app-store chrome screenshots and scraped gig posters kept as design
# reference, and nothing in the product references them.

# Machine-local Claude settings (not shared)
.claude/settings.local.json

# Build caches (were previously tracked under app/)
.gradle/
.next/
