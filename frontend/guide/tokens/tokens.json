{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MusicLinkd Enterprise Design Tokens",
    "version": "6.0.0",
    "sourceOfTruth": "guide/tokens/tokens.json",
    "interactiveReference": "guide/styleguide.html",
    "note": "v6.0: every numeric category (spacing, radius, opacity, motion, type) collapsed to exactly 4 tokens on an exponential scale, matching guide/styleguide.html."
  },
  "foundation": {
    "color": {
      "pink": {
        "$value": "#EA4C89",
        "$type": "color"
      },
      "navy": {
        "$value": "#0D0B26",
        "$type": "color"
      },
      "paper": {
        "$value": "#FCFCFD",
        "$type": "color"
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color"
      },
      "line": {
        "$value": "#ECECF1",
        "$type": "color"
      },
      "muted": {
        "$value": "#7D7D8E",
        "$type": "color"
      },
      "green": {
        "$value": "#22C55E",
        "$type": "color"
      },
      "amber": {
        "$value": "#F59E0B",
        "$type": "color"
      },
      "red": {
        "$value": "#DC2626",
        "$type": "color"
      }
    },
    "spacing": {
      "1": {
        "$value": "4dp",
        "$type": "dimension",
        "$description": "Badge internal, icon gaps"
      },
      "2": {
        "$value": "8dp",
        "$type": "dimension",
        "$description": "Compact gaps, chip padding"
      },
      "3": {
        "$value": "16dp",
        "$type": "dimension",
        "$description": "Card padding, default gaps"
      },
      "4": {
        "$value": "32dp",
        "$type": "dimension",
        "$description": "Section spacing, page margins, hero padding"
      }
    },
    "radius": {
      "1": {
        "$value": "8dp",
        "$type": "dimension",
        "$description": "Chips, small controls"
      },
      "2": {
        "$value": "16dp",
        "$type": "dimension",
        "$description": "Media, toasts, inputs"
      },
      "3": {
        "$value": "32dp",
        "$type": "dimension",
        "$description": "Cards, containers"
      },
      "4": {
        "$value": "9999dp",
        "$type": "dimension",
        "$description": "Pill / full round (buttons, chips, avatars) — functional token, not a numeric-scale step"
      }
    },
    "opacity": {
      "1": { "$value": 0.08, "$type": "number", "$description": "Hover overlay" },
      "2": { "$value": 0.16, "$type": "number", "$description": "Pressed / ripple feedback" },
      "3": { "$value": 0.32, "$type": "number", "$description": "Disabled state, drawer/menu scrim" },
      "4": { "$value": 0.64, "$type": "number", "$description": "Modal backdrop overlay" }
    },
    "motion": {
      "1": { "$value": "125ms", "$type": "duration", "$description": "Ripple, button press, chip toggle" },
      "2": { "$value": "200ms", "$type": "duration", "$description": "Hover lift, icon change" },
      "3": { "$value": "320ms", "$type": "duration", "$description": "Card lift, sheet reveal" },
      "4": { "$value": "500ms", "$type": "duration", "$description": "Modal, splash, entrance" },
      "curveStandard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "curveDecelerate": { "$value": "cubic-bezier(0.0, 0, 0.2, 1)", "$type": "cubicBezier" },
      "curveAccelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" }
    },
    "type": {
      "1": { "$value": { "min": "10px", "max": "12px" }, "$type": "fluidDimension", "$description": "Micro labels, captions, badges, metadata" },
      "2": { "$value": { "min": "14px", "max": "18px" }, "$type": "fluidDimension", "$description": "Body text, default UI copy, small headings" },
      "3": { "$value": { "min": "20px", "max": "28px" }, "$type": "fluidDimension", "$description": "Section headings, card titles" },
      "4": { "$value": { "min": "28px", "max": "44px" }, "$type": "fluidDimension", "$description": "Display, hero headlines" }
    },
    "touch": {
      "targetMin": {
        "$value": "48dp",
        "$type": "dimension"
      },
      "comfortable": {
        "$value": "56dp",
        "$type": "dimension"
      }
    },
    "safeArea": {
      "top": {
        "$value": "24dp",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "16dp",
        "$type": "dimension"
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": {
        "$value": "{foundation.color.paper}",
        "$type": "color"
      },
      "card": {
        "$value": "{foundation.color.white}",
        "$type": "color"
      },
      "navyHero": {
        "$value": "{foundation.color.navy}",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "{foundation.color.navy}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{foundation.color.muted}",
        "$type": "color"
      },
      "brand": {
        "$value": "{foundation.color.pink}",
        "$type": "color"
      }
    },
    "audio": {
      "playerHeight": {
        "$value": "72dp",
        "$type": "dimension"
      },
      "waveformActive": {
        "$value": "{foundation.color.pink}",
        "$type": "color"
      },
      "waveformBuffer": {
        "$value": "{foundation.color.line}",
        "$type": "color"
      }
    },
    "haptic": {
      "selection": {
        "$value": "AndroidHapticFeedback.SELECTION",
        "$type": "haptic"
      },
      "success": {
        "$value": "AndroidHapticFeedback.CONFIRM",
        "$type": "haptic"
      },
      "waveform": {
        "$value": "AndroidHapticFeedback.VIRTUAL_KEY",
        "$type": "haptic"
      }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": {
          "$value": "{semantic.text.brand}",
          "$type": "color"
        },
        "text": {
          "$value": "{foundation.color.white}",
          "$type": "color"
        },
        "minHeight": {
          "$value": "{foundation.touch.targetMin}",
          "$type": "dimension"
        }
      }
    },
    "waveformPlayer": {
      "activeBar": {
        "$value": "{semantic.audio.waveformActive}",
        "$type": "color"
      },
      "barWidth": {
        "$value": "3dp",
        "$type": "dimension"
      }
    }
  },
  "screen": {
    "discover": {
      "heroBackground": {
        "$value": "{semantic.surface.navyHero}",
        "$type": "color"
      }
    },
    "profile": {
      "headerHeight": {
        "$value": "120dp",
        "$type": "dimension"
      }
    }
  }
}