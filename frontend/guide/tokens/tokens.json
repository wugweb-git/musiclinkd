{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MusicLinkd Enterprise Design Tokens",
    "version": "7.0.0",
    "sourceOfTruth": "guide/tokens/tokens.json",
    "interactiveReference": "guide/styleguide.html",
    "note": "v7.0: layered Gestalt (Pinterest, github.com/pinterest/gestalt, Apache-2.0) design tokens on top of the v6.0 4-token core. The v6.0 core (foundation.spacing/radius/opacity/motion/type, prefixed 1-4) is UNCHANGED — every consumer of --space-1..4, --radius-1..4, --duration-1..4, --type-1..4, --opacity-1..4 keeps rendering identically. Verified: MusicLinkd's spacing (4/8/16/32) and radius (8/16/32/pill) already land exactly on Gestalt's real space-100/200/400/800 and rounding-200/400/800/pill steps, so the new foundation.gestalt.* scale below is a superset, not a fork. Opacity, type (fluid clamps) and motion diverge from Gestalt's fixed-step originals by deliberate MusicLinkd choice (documented per-section below) and are kept as-is; Gestalt's real values are still provided in full under foundation.gestalt for new work.",
    "gestaltSource": {
      "repo": "https://github.com/pinterest/gestalt",
      "license": "Apache-2.0",
      "extractedFrom": "packages/gestalt-design-tokens/tokens (classic + vr-theme)",
      "commit": "shallow clone, 2026-08-12"
    }
  },
  "foundation": {
    "color": {
      "pink": { "$value": "#EA4C89", "$type": "color" },
      "navy": { "$value": "#0D0B26", "$type": "color" },
      "paper": { "$value": "#FCFCFD", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "line": { "$value": "#ECECF1", "$type": "color" },
      "muted": { "$value": "#7D7D8E", "$type": "color" },
      "green": { "$value": "#22C55E", "$type": "color" },
      "amber": { "$value": "#F59E0B", "$type": "color" },
      "red": { "$value": "#DC2626", "$type": "color" },
      "neutral": {
        "$description": "Gestalt's gray/roboflow ramp, hue-neutral so it carries no brand meaning — safe reuse per guide/README boundaries (no purple, no competing brand palette). --line and --muted are aliased onto the closest steps for continuity.",
        "50": { "$value": "#F9F9F9", "$type": "color" },
        "100": { "$value": "#F1F1F1", "$type": "color" },
        "200": { "$value": "#E9E9E9", "$type": "color", "$description": "nearest neighbour of foundation.color.line (#ECECF1)" },
        "300": { "$value": "#CDCDCD", "$type": "color" },
        "400": { "$value": "#A5A5A5", "$type": "color" },
        "500": { "$value": "#767676", "$type": "color" },
        "550": { "$value": "#5F5F5F", "$type": "color", "$description": "nearest neighbour of foundation.color.muted (#7D7D8E) is 500; 550 sits one step darker" },
        "600": { "$value": "#4A4A4A", "$type": "color" },
        "700": { "$value": "#2B2B2B", "$type": "color" },
        "800": { "$value": "#191919", "$type": "color" }
      }
    },
    "spacing": {
      "1": { "$value": "4dp", "$type": "dimension", "$description": "Badge internal, icon gaps" },
      "2": { "$value": "8dp", "$type": "dimension", "$description": "Compact gaps, chip padding" },
      "3": { "$value": "16dp", "$type": "dimension", "$description": "Card padding, default gaps" },
      "4": { "$value": "32dp", "$type": "dimension", "$description": "Section spacing, page margins, hero padding" }
    },
    "radius": {
      "1": { "$value": "8dp", "$type": "dimension", "$description": "Chips, small controls" },
      "2": { "$value": "16dp", "$type": "dimension", "$description": "Media, toasts, inputs" },
      "3": { "$value": "32dp", "$type": "dimension", "$description": "Cards, containers" },
      "4": { "$value": "9999dp", "$type": "dimension", "$description": "Pill / full round (buttons, chips, avatars) — functional token, not a numeric-scale step" }
    },
    "opacity": {
      "1": { "$value": 0.08, "$type": "number", "$description": "Hover overlay" },
      "2": { "$value": 0.16, "$type": "number", "$description": "Pressed / ripple feedback" },
      "3": { "$value": 0.32, "$type": "number", "$description": "Disabled state, drawer/menu scrim" },
      "4": { "$value": 0.64, "$type": "number", "$description": "Modal backdrop overlay" }
    },
    "motion": {
      "1": { "$value": "125ms", "$type": "duration", "$description": "Ripple, button press, chip toggle" },
      "2": { "$value": "200ms", "$type": "duration", "$description": "Hover lift, icon change" },
      "3": { "$value": "320ms", "$type": "duration", "$description": "Card lift, sheet reveal" },
      "4": { "$value": "500ms", "$type": "duration", "$description": "Modal, splash, entrance" },
      "curveStandard": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier" },
      "curveDecelerate": { "$value": "cubic-bezier(0.0, 0, 0.2, 1)", "$type": "cubicBezier" },
      "curveAccelerate": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" }
    },
    "type": {
      "1": { "$value": { "min": "10px", "max": "12px" }, "$type": "fluidDimension", "$description": "Micro labels, captions, badges, metadata" },
      "2": { "$value": { "min": "14px", "max": "18px" }, "$type": "fluidDimension", "$description": "Body text, default UI copy, small headings" },
      "3": { "$value": { "min": "20px", "max": "28px" }, "$type": "fluidDimension", "$description": "Section headings, card titles" },
      "4": { "$value": { "min": "28px", "max": "44px" }, "$type": "fluidDimension", "$description": "Display, hero headlines" }
    },
    "touch": {
      "targetMin": { "$value": "48dp", "$type": "dimension" },
      "comfortable": { "$value": "56dp", "$type": "dimension" }
    },
    "safeArea": {
      "top": { "$value": "24dp", "$type": "dimension" },
      "bottom": { "$value": "16dp", "$type": "dimension" }
    },
    "gestalt": {
      "$description": "Full-fidelity Gestalt token scales, extracted verbatim (values only — brand hues excluded, see meta.note). Additive: nothing in foundation.* above references these. Use directly for new component work that needs finer steps than the v6.0 core provides.",
      "space": {
        "$unit": "px",
        "0": 0, "100": 4, "200": 8, "300": 12, "400": 16, "500": 20, "600": 24, "700": 28,
        "800": 32, "900": 36, "1000": 40, "1100": 44, "1200": 48, "1300": 52, "1400": 56, "1500": 60, "1600": 64
      },
      "rounding": {
        "$unit": "px",
        "0": 0, "100": 4, "200": 8, "300": 12, "400": 16, "500": 20, "600": 24, "700": 28, "800": 32,
        "pill": 999, "circle": "50%"
      },
      "opacity": {
        "$description": "Gestalt's real opacity ramp — diverges from foundation.opacity above (MusicLinkd's own hover/pressed/disabled/scrim choices), kept separate rather than overriding shipped interaction states.",
        "0": 0, "100": 0.04, "200": 0.2, "300": 0.4, "400": 0.8, "500": 0.9
      },
      "font": {
        "size": { "100": "12px", "200": "14px", "300": "16px", "400": "20px", "500": "28px", "600": "36px" },
        "weight": { "normal": 400, "semibold": 600, "bold": 700 },
        "$description": "Fixed-step scale, for reference only — MusicLinkd's foundation.type uses fluid clamp() by deliberate choice (see frontend/guide/README.md) and is not being replaced by this fixed scale."
      },
      "elevation": {
        "floating": { "$value": "0px 0px 8px rgba(0,0,0,0.1)", "$description": "Popover, menu, tooltip" },
        "raisedTop": { "$value": "0px 2px 8px rgba(0,0,0,0.12)", "$description": "Card/sheet top edge shadow" },
        "raisedBottom": { "$value": "0px -2px 8px rgba(0,0,0,0.12)", "$description": "Sticky bottom bar shadow" },
        "darkMode": "none — Gestalt drops shadows in dark mode in favor of a 1px border; see comp-web-color-dark border tokens if MusicLinkd adds dark mode."
      },
      "motion": {
        "duration": { "0": 0, "50": 50, "100": 100, "150": 150, "200": 200, "300": 300, "400": 400, "500": 500, "600": 600, "700": 700, "900": 900 },
        "easing": {
          "linear": "cubic-bezier(0, 0, 1, 1)",
          "expressive": "cubic-bezier(0.55, 0, 0, 1)",
          "lateral": "cubic-bezier(0.8, 0, 0.2, 1)",
          "bounce": "cubic-bezier(0, 0.35, 0, 1.25)",
          "enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
          "exit": "cubic-bezier(0.3, 0, 0.8, 0.15)"
        },
        "semantic": {
          "$description": "Gestalt's real component motion recipes (duration + easing pairs). Reference for expanding MusicLinkd's motion language beyond the current single curveStandard.",
          "fadein": { "duration": 300, "easing": "lateral" },
          "fadeout": { "duration": 200, "easing": "lateral" },
          "enter": { "duration": 300, "easing": "bounce" },
          "exit": { "duration": 300, "easing": "exit" },
          "swipe": { "duration": 400, "easing": "lateral" },
          "scaleOn": { "duration": 150, "easing": "linear" },
          "colorChange": { "duration": 300, "easing": "linear" }
        }
      }
    }
  },
  "semantic": {
    "surface": {
      "canvas": { "$value": "{foundation.color.paper}", "$type": "color" },
      "card": { "$value": "{foundation.color.white}", "$type": "color" },
      "navyHero": { "$value": "{foundation.color.navy}", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "{foundation.color.navy}", "$type": "color" },
      "secondary": { "$value": "{foundation.color.muted}", "$type": "color" },
      "brand": { "$value": "{foundation.color.pink}", "$type": "color" }
    },
    "audio": {
      "playerHeight": { "$value": "72dp", "$type": "dimension" },
      "waveformActive": { "$value": "{foundation.color.pink}", "$type": "color" },
      "waveformBuffer": { "$value": "{foundation.color.line}", "$type": "color" }
    },
    "haptic": {
      "selection": { "$value": "AndroidHapticFeedback.SELECTION", "$type": "haptic" },
      "success": { "$value": "AndroidHapticFeedback.CONFIRM", "$type": "haptic" },
      "waveform": { "$value": "AndroidHapticFeedback.VIRTUAL_KEY", "$type": "haptic" }
    }
  },
  "component": {
    "button": {
      "primary": {
        "background": { "$value": "{semantic.text.brand}", "$type": "color" },
        "text": { "$value": "{foundation.color.white}", "$type": "color" },
        "minHeight": { "$value": "{foundation.touch.targetMin}", "$type": "dimension" }
      }
    },
    "waveformPlayer": {
      "activeBar": { "$value": "{semantic.audio.waveformActive}", "$type": "color" },
      "barWidth": { "$value": "3dp", "$type": "dimension" }
    }
  },
  "screen": {
    "discover": {
      "heroBackground": { "$value": "{semantic.surface.navyHero}", "$type": "color" }
    },
    "profile": {
      "headerHeight": { "$value": "120dp", "$type": "dimension" }
    }
  }
}
